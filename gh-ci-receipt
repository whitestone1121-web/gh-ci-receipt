#!/usr/bin/env python3
"""Read-only timing receipts for GitHub Actions."""

import argparse
from collections import defaultdict
from datetime import datetime
import html
import json
import re
import statistics
import subprocess
import sys


def api(path, paginate=False):
    command = ["gh", "api", "--hostname", "github.com", "--method", "GET"]
    if paginate:
        command += ["--paginate"]
    try:
        result = subprocess.run(command + [path], capture_output=True, text=True,
                                check=True, timeout=90)
    except FileNotFoundError as error:
        raise ValueError("Install GitHub CLI and authenticate with gh auth login.") from error
    except subprocess.CalledProcessError as error:
        raise ValueError(error.stderr.strip() or "GitHub API request failed.") from error
    if not paginate:
        return json.loads(result.stdout)
    decoder = json.JSONDecoder()
    pages = []
    remaining = result.stdout.lstrip()
    while remaining:
        page, end = decoder.raw_decode(remaining)
        pages.append(page)
        remaining = remaining[end:].lstrip()
    return pages


def timestamp(value):
    if value is None or value == "":
        return None
    if not isinstance(value, str):
        raise ValueError("GitHub timestamps must be ISO 8601 strings.")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise ValueError("Invalid GitHub timestamp; expected ISO 8601 with a timezone.") from error
    if parsed.utcoffset() is None:
        raise ValueError("GitHub timestamp is missing a timezone.")
    return parsed


def elapsed(start, end):
    if start is None or end is None or end < start:
        return None
    return (end - start).total_seconds()


def fetch_jobs(repo, run):
    attempt = run["run_attempt"]
    path = f"repos/{repo}/actions/runs/{run['id']}/attempts/{attempt}/jobs?per_page=100"
    pages = api(path, paginate=True)
    jobs = {job["id"]: job for page in pages for job in page["jobs"]}
    if not pages or len(jobs) != pages[0]["total_count"]:
        raise ValueError(f"Incomplete job data for run {run['id']} attempt {attempt}.")
    return list(jobs.values())


def summarize(run, jobs):
    start = timestamp(run.get("run_started_at"))
    spans = []
    for job in jobs:
        if job.get("conclusion") == "skipped":
            continue
        began = timestamp(job.get("started_at"))
        ended = timestamp(job.get("completed_at"))
        duration = elapsed(began, ended)
        if duration is not None:
            spans.append((job, began, ended, duration))
    # Never estimate wall or runner totals from a partial set of timed jobs.
    timed = bool(spans) and len(spans) == sum(j.get("conclusion") != "skipped" for j in jobs)
    # A rerun may carry forward work from an earlier attempt. Its attempt job
    # endpoint cannot reconstruct the wall time for a comparable full run.
    wall = None
    if timed and run["run_attempt"] == 1:
        wall = elapsed(start, max(item[2] for item in spans))
    return {
        "wall": wall,
        "runner": sum(item[3] for item in spans) if timed else None,
        "jobs": spans,
        "job_names": sorted(job["name"] for job in jobs if job.get("conclusion") != "skipped"),
        "runner_labels": sorted(
            (job["name"], tuple(sorted(job.get("labels") or [])))
            for job in jobs if job.get("conclusion") != "skipped"
        ),
    }


def duration(seconds):
    if seconds is None:
        return "unavailable"
    whole = round(abs(seconds))
    minutes, rest = divmod(whole, 60)
    return f"{minutes}m {rest:02d}s" if minutes else f"{rest}s"


def safe(value):
    text = html.escape(str(value)).replace("\\", "\\\\")
    for character, entity in (("|", "&#124;"), ("[", "&#91;"), ("]", "&#93;")):
        text = text.replace(character, entity)
    for character in ("*", "_", "`", "~"):
        text = text.replace(character, "\\" + character)
    return text.replace("\n", " ").replace("\r", " ")


def run_link(repo, run):
    return f"[#{run['id']}](https://github.com/{repo}/actions/runs/{run['id']})"


def audit(repo, count, workflow):
    scope = f"workflows/{workflow}/runs" if workflow else "runs"
    listing = api(f"repos/{repo}/actions/{scope}?status=completed&per_page={count}")
    runs = listing["workflow_runs"][:count]
    if not runs:
        raise ValueError("No completed workflow runs matched.")
    rows = []
    samples = defaultdict(list)
    for run in runs:
        receipt = summarize(run, fetch_jobs(repo, run))
        rows.append(f"| {run_link(repo, run)} | {safe(run['name'])} | {safe(run['conclusion'])} "
                    f"| {run['run_attempt']} | {duration(receipt['wall'])} "
                    f"| {duration(receipt['runner'])} |")
        for job, _, _, _ in receipt["jobs"]:
            for step in job.get("steps", []):
                seconds = elapsed(timestamp(step.get("started_at")), timestamp(step.get("completed_at")))
                if step.get("conclusion") in ("skipped", "cancelled") or seconds is None:
                    continue
                key = (run["workflow_id"], run["name"], job["name"], step["name"])
                url = f"https://github.com/{repo}/actions/runs/{run['id']}/job/{job['id']}"
                samples[key].append((seconds, url))
    lines = [f"# CI Receipt for {safe(repo)}", "",
             "| Run | Workflow | Result | Attempt | Wall | Runner time |",
             "| --- | --- | --- | ---: | ---: | ---: |", *rows, "",
             "## Slowest observed steps by median duration", "",
             "| Workflow | Job | Step | Median | Samples | Slowest example |",
             "| --- | --- | --- | ---: | ---: | --- |"]
    ranked = sorted(samples.items(), key=lambda item: (
        -statistics.median(sample[0] for sample in item[1]), item[0]))
    for (_, workflow_name, job_name, step), values in ranked[:10]:
        median = statistics.median(seconds for seconds, _ in values)
        _, url = max(values)
        lines.append(f"| {safe(workflow_name)} | {safe(job_name)} | {safe(step)} | "
                     f"{duration(median)} | {len(values)} | [Job log]({url}) |")
    lines += ["", "Step samples count timed occurrences, not unique runs. Repeated same-named "
              "steps in one job share a bucket. Timed failed steps are included; skipped and "
              "cancelled steps are excluded.", "", "Step rank reflects observed duration. "
              "Parallel steps can overlap and the ranking does not identify the workflow "
              "critical path.", "", METHODS]
    return "\n".join(lines)


METHODS = ("Wall is workflow start to last observed non-skipped job completion, excluding "
           "initial workflow queue time. Runner time sums timed job spans, including setup and "
           "cleanup, and is separate from billed minutes. Reruns show attempt runner time only. "
           "Generated by CI Receipt from SignalBrain.")


def compare(repo, before_id, after_id):
    before = api(f"repos/{repo}/actions/runs/{before_id}")
    after = api(f"repos/{repo}/actions/runs/{after_id}")
    if any(run.get("status") != "completed" for run in (before, after)):
        raise ValueError("Compare requires two completed runs.")
    first = summarize(before, fetch_jobs(repo, before))
    second = summarize(after, fetch_jobs(repo, after))
    differences = []
    for field, label in (("workflow_id", "workflow"), ("event", "trigger event"),
                         ("head_branch", "branch"), ("conclusion", "result")):
        if before.get(field) != after.get(field):
            differences.append(label)
    if first["job_names"] != second["job_names"]:
        differences.append("job set")
    if first["runner_labels"] != second["runner_labels"]:
        differences.append("runner labels")
    if before["run_attempt"] != 1 or after["run_attempt"] != 1:
        differences.append("rerun attempt coverage")
    if before.get("conclusion") != "success" or after.get("conclusion") != "success":
        differences.append("at least one unsuccessful run")
    lines = ["# CI Receipt comparison", "",
             f"Before {run_link(repo, before)} · After {run_link(repo, after)}", "",
             "| Metric | Before | After | Observed change |",
             "| --- | ---: | ---: | ---: |"]
    for key, label in (("wall", "Wall"), ("runner", "Runner time")):
        old, new = first[key], second[key]
        change = "unavailable"
        if old is not None and new is not None:
            delta = new - old
            change = f"{'+' if delta > 0 else '−' if delta < 0 else ''}{duration(delta)}"
            if old:
                change += f" ({delta / old:+.1%})"
        lines.append(f"| {label} | {duration(old)} | {duration(new)} | {change} |")
    if differences:
        lines += ["", "**Comparability flags** · " + ", ".join(differences) + "."]
    lines += ["", "One pair measures an observed difference. Flags cover workflow metadata, "
              "job names, and runner labels; they do not prove matching matrix configuration, "
              "cache state, workflow contents, or changed code. Review those before attributing "
              "a difference to a change.", "", METHODS]
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(prog="gh ci-receipt", description=__doc__)
    commands = parser.add_subparsers(dest="action", required=True)
    audit_cmd = commands.add_parser("audit", help="Rank slow steps across completed runs")
    audit_cmd.add_argument("repo", metavar="OWNER/REPO")
    audit_cmd.add_argument("--runs", type=int, default=10)
    audit_cmd.add_argument("--workflow", help="Workflow ID or filename, such as ci.yml")
    compare_cmd = commands.add_parser("compare", help="Compare two completed runs")
    compare_cmd.add_argument("before", type=int)
    compare_cmd.add_argument("after", type=int)
    compare_cmd.add_argument("--repo", help="OWNER/REPO; defaults to the current gh repository")
    args = parser.parse_args()
    try:
        repo = args.repo
        if not repo:
            result = subprocess.run(["gh", "repo", "view", "--json", "nameWithOwner,url"],
                                    capture_output=True, text=True, check=True, timeout=30)
            current = json.loads(result.stdout)
            if not current["url"].startswith("https://github.com/"):
                raise ValueError("CI Receipt supports repositories on github.com.")
            repo = current["nameWithOwner"]
        if not re.fullmatch(r"[A-Za-z0-9-]+/[A-Za-z0-9_.-]+", repo) or repo.split("/")[1] in (".", ".."):
            raise ValueError("Use a github.com repository in OWNER/REPO form.")
        if args.action == "audit":
            if not 1 <= args.runs <= 50:
                raise ValueError("--runs must be between 1 and 50.")
            if args.workflow and (args.workflow in (".", "..") or
                                  not re.fullmatch(r"[A-Za-z0-9_.-]+", args.workflow)):
                raise ValueError("--workflow must be a workflow ID or filename.")
            print(audit(repo, args.runs, args.workflow))
        else:
            if min(args.before, args.after) < 1 or args.before == args.after:
                raise ValueError("Supply two distinct positive run IDs.")
            print(compare(repo, args.before, args.after))
    except (ValueError, KeyError, OSError, subprocess.SubprocessError) as error:
        print(f"ci-receipt: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
